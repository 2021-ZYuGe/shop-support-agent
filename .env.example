APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# MySQL: create a dedicated application account, never use root.
DATABASE_URL=mysql+pymysql://shop_support_app:CHANGE_ME@127.0.0.1:3306/shop_support_dev?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://shop_support_app:CHANGE_ME@127.0.0.1:3306/shop_support_test?charset=utf8mb4

# Admin session and seeded demo administrator.
SESSION_COOKIE_NAME=shop_support_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=8
SEED_ADMIN_EMAIL=admin@qinghe.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=店铺运营

# Local frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI providers. Keys stay server-side and must never be committed.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Chroma is local and rebuildable from MySQL.
CHROMA_PATH=./data/chroma_dev
