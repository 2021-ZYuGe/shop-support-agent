APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# MySQL: create a dedicated application account, never use root.
DATABASE_URL=mysql+pymysql://shop_support_app:CHANGE_ME@127.0.0.1:3306/shop_support_dev?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://shop_support_app:CHANGE_ME@127.0.0.1:3306/shop_support_test?charset=utf8mb4

# Admin session and seeded demo administrator.
SESSION_COOKIE_NAME=shop_support_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=8
SEED_ADMIN_EMAIL=admin@qinghe.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=店铺运营

# Local frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI providers. Keys stay server-side and must never be committed.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=1000
# Approximate display prices; confirm with the provider before real billing.
DEEPSEEK_INPUT_PRICE_CNY_PER_MILLION=1.0
DEEPSEEK_OUTPUT_PRICE_CNY_PER_MILLION=4.0

# RAG answer grounding
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.40
CHAT_HISTORY_LIMIT=6
CHAT_HISTORY_MESSAGE_CHARS=1200
CHAT_MAX_MESSAGE_CHARS=1000

# Local business tools
TOOL_TIMEOUT_MS=5000
MAX_TOOL_CALLS_PER_TURN=3

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_SECONDS=60

# Chroma is local and rebuildable from MySQL.
CHROMA_PATH=./data/chroma_dev
CHROMA_COLLECTION=knowledge_chunks
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10
